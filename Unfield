            AddCorner(btn, 6)
            AddStroke(btn, theme.ElementStroke, 1, 0)
            btn.MouseButton1Click:Connect(function()
                if type(act.Callback) == "function" then
                    task.spawn(act.Callback)
                end
                Tween(card, 0.35, { Position = UDim2.new(1, 50, 0, 0), BackgroundTransparency = 1 })
                task.delay(0.35, function()
                    if wrapper and wrapper.Parent then wrapper:Destroy() end
                end)
            end)
        end
    end

    local progressBar = Create("Frame", {
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 0, 1, 0),
        Size = UDim2.new(1, 0, 0, 3),
        BackgroundColor3 = theme.Accent,
        BorderSizePixel = 0,
        Parent = card
    })

    -- Slide in from right with Quint easing
    Tween(card, 0.45, { Position = UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    Tween(progressBar, duration, { Size = UDim2.new(0, 0, 0, 3) }, Enum.EasingStyle.Linear)

    task.delay(duration, function()
        if not wrapper or not wrapper.Parent then return end
        Tween(card, 0.4, { Position = UDim2.new(1, 60, 0, 0), BackgroundTransparency = 1 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        Tween(stroke, 0.3, { Transparency = 1 })
        task.wait(0.42)
        if wrapper and wrapper.Parent then
            wrapper:Destroy()
        end
    end)
end

