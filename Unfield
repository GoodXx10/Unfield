                    task.spawn(callback, state)
                end
                Rayfield:SaveConfiguration()
            end

            ToggleCard.MouseButton1Click:Connect(function()
                PlayRipple(ToggleCard, theme.Accent)
                UpdateVisual(not state, true)
            end)

            function ToggleObj:Set(newVal)
