        Tween(WindowScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        Tween(SplashTitle, 0.35, { TextTransparency = 0 })
        task.delay(0.1, function()
            Tween(SplashSub, 0.35, { TextTransparency = 0 })
            Tween(SplashBarBg, 0.3, { BackgroundTransparency = 0 })
            Tween(SplashBarFill, 0.85, { Size = UDim2.new(1, 0, 1, 0) }, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
        end)

        -- Step 2: Fade out splash text & morph the frame directly into the full Window
        task.delay(1.05, function()
            if not MainFrame or not MainFrame.Parent then return end
            Tween(SplashTitle, 0.22, { TextTransparency = 1 })
            Tween(SplashSub, 0.22, { TextTransparency = 1 })
            Tween(SplashBarBg, 0.2, { BackgroundTransparency = 1 })
            Tween(SplashBarFill, 0.2, { BackgroundTransparency = 1 })

            Topbar.Visible = true
            BodyFrame.Visible = true

            -- Morph splash box to full window dimensions with signature Quint easing
            Tween(MainFrame, 0.55, { Size = FULL_SIZE }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
            Tween(SplashOverlay, 0.4, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

            task.delay(0.42, function()
                if SplashOverlay and SplashOverlay.Parent then
                    SplashOverlay:Destroy()
                end
            end)
        end)
