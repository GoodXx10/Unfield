        function TabObj:CreateSlider(sConfig)
            sConfig = sConfig or {}
            local sName = sConfig.Name or "Slider"
            local range = sConfig.Range or { 0, 100 }
            local minVal = range[1] or 0
            local maxVal = range[2] or 100
            local increment = sConfig.Increment or 1
            local suffix = sConfig.Suffix and (" " .. tostring(sConfig.Suffix)) or ""
            local currentVal = math.clamp(sConfig.CurrentValue or minVal, minVal, maxVal)
            local flag = sConfig.Flag
            local callback = sConfig.Callback or function() end

            local SliderCard = Create("Frame", {
                Name = "Slider_" .. sName,
                Size = UDim2.new(1, 0, 0, 56),
                BackgroundColor3 = theme.ElementBackground,
                Parent = Page
            })
            SliderCard:SetAttribute("SearchTitle", sName)
            AddCorner(SliderCard, 8)
            local SliderStroke = AddStroke(SliderCard, theme.ElementStroke, 1, 0)
            AttachHoverAnimation(SliderCard, SliderStroke)

            Create("TextLabel", {
                Position = UDim2.new(0, 12, 0, 8),
                Size = UDim2.new(0.65, -12, 0, 18),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamMedium,
                Text = sName,
                TextColor3 = theme.TextColor,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = SliderCard
            })

            local ValueLabel = Create("TextLabel", {
                AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -12, 0, 8),
                Size = UDim2.new(0.35, -12, 0, 18),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBold,
                Text = tostring(currentVal) .. suffix,
                TextColor3 = theme.SubTextColor,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Right,
                Parent = SliderCard
            })

            local BarBg = Create("Frame", {
                Position = UDim2.new(0, 12, 0, 34),
                Size = UDim2.new(1, -24, 0, 10),
                BackgroundColor3 = theme.SliderBackground,
                Parent = SliderCard
            })
            AddCorner(BarBg, 5)
            AddStroke(BarBg, theme.SliderStroke, 1, 0.4)

            local initialRatio = (maxVal > minVal) and ((currentVal - minVal) / (maxVal - minVal)) or 0
            local BarFill = Create("Frame", {
                Size = UDim2.new(initialRatio, 0, 1, 0),
                BackgroundColor3 = theme.SliderProgress,
                Parent = BarBg
            })
            AddCorner(BarFill, 5)

            local SliderObj = {
                Type = "Slider",
                CurrentValue = currentVal
            }

            local function RoundIncrement(val)
                local snapped = minVal + math.floor(((val - minVal) / increment) + 0.5) * increment
                local decimals = tostring(increment):match("%.(%d+)")
                if decimals then
                    snapped = tonumber(string.format("%." .. #decimals .. "f", snapped))
                end
                return math.clamp(snapped, minVal, maxVal)
            end

            local function SetValue(newValue, fireCallback)
                currentVal = RoundIncrement(newValue)
                SliderObj.CurrentValue = currentVal
                local ratio = (maxVal > minVal) and ((currentVal - minVal) / (maxVal - minVal)) or 0
                Tween(BarFill, 0.14, { Size = UDim2.new(ratio, 0, 1, 0) }, Enum.EasingStyle.Quint)
                ValueLabel.Text = tostring(currentVal) .. suffix
                if fireCallback then
                    task.spawn(callback, currentVal)
                end
                Rayfield:SaveConfiguration()
            end

            local draggingSlider = false
            local function UpdateFromInput(input)
                local relX = math.clamp((input.Position.X - BarBg.AbsolutePosition.X) / BarBg.AbsoluteSize.X, 0, 1)
                local rawVal = minVal + (maxVal - minVal) * relX
                SetValue(rawVal, true)
            end

            BarBg.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    draggingSlider = true
                    UpdateFromInput(input)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    draggingSlider = false
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    UpdateFromInput(input)
                end
            end)

            function SliderObj:Set(newVal)
                SetValue(newVal, true)
            end

            if flag then
                Rayfield.Flags[flag] = SliderObj
            end

            return SliderObj
        end

