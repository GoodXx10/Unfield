                TextSize = 12,
                Parent = HeaderBtn
            })

            local ListHolder = Create("Frame", {
                Position = UDim2.new(0, 8, 0, 44),
                Size = UDim2.new(1, -16, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                Parent = DropCard
            })
