                            task.wait(0.05)
                        end
                        Tween(KeyStroke, 0.3, { Color = theme.ElementStroke })
                    end)
                    Rayfield:Notify({
                        Title = "Key System",
                        Content = "Invalid key entered. Please try again.",
                        Image = "alert-triangle",
                        Duration = 3
