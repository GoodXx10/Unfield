                state and theme.ToggleEnabledStroke or theme.ToggleDisabledStroke,
                1,
                0
            )

            local ToggleObj = {
                Type = "Toggle",
                CurrentValue = state
            }

            local function UpdateVisual(val, invokeCallback)
                state = (val == true)
                ToggleObj.CurrentValue = state
                -- Knob stretch & glide animation
                Tween(Knob, 0.28, {
                    Position = state and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
