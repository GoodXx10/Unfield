local function FormatAsset(icon)
    if not icon or icon == 0 or icon == "" then
        return nil
    end
    if typeof(icon) == "number" then
        return "rbxassetid://" .. tostring(icon)
    elseif typeof(icon) == "string" then
        local lower = icon:lower()
        if Rayfield.LucideIcons[lower] then
            return Rayfield.LucideIcons[lower]
        elseif icon:match("^rbxassetid://") or icon:match("^http") then
            return icon
        elseif tonumber(icon) then
            return "rbxassetid://" .. icon
        end
    end
    return "rbxassetid://4483362458"
end

