-- Interactive Ripple Effect on Click (Signature Rayfield/Material feedback)
local function PlayRipple(button, accentColor)
    task.spawn(function()
        local mousePos = UserInputService:GetMouseLocation()
        local relX = mousePos.X - button.AbsolutePosition.X
        local relY = mousePos.Y - button.AbsolutePosition.Y - 36

        local circle = Create("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0, math.clamp(relX, 10, button.AbsoluteSize.X - 10), 0, math.clamp(relY, 6, button.AbsoluteSize.Y - 6)),
            Size = UDim2.new(0, 0, 0, 0),
            BackgroundColor3 = accentColor or Color3.fromRGB(255, 255, 255),
            BackgroundTransparency = 0.72,
            BorderSizePixel = 0,
            ZIndex = button.ZIndex + 2,
            Parent = button
        })
        AddCorner(circle, 999)

        local targetDiameter = math.max(button.AbsoluteSize.X, button.AbsoluteSize.Y) * 1.6
        Tween(circle, 0.45, {
            Size = UDim2.new(0, targetDiameter, 0, targetDiameter),
            BackgroundTransparency = 1
        }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        task.wait(0.46)
        if circle and circle.Parent then
            circle:Destroy()
        end
    end)
end

local function MakeDraggable(dragHandle, targetFrame)
    local dragging = false
    local dragInput = nil
    local dragStart = nil
    local startPos = nil

    dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = targetFrame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    dragHandle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            Tween(targetFrame, 0.12, {
                Position = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + delta.X,
                    startPos.Y.Scale,
                    startPos.Y.Offset + delta.Y
                )
            }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        end
    end)
end

-- ============================================================================
-- CONFIGURATION SAVING & LOADING
-- ============================================================================
function Rayfield:SaveConfiguration()
    if not self.ConfigurationSaving.Enabled then
        return
    end
    pcall(function()
        if not writefile then return end
        local folder = self.ConfigurationSaving.FolderName or self.Folder
        local file = (self.ConfigurationSaving.FileName or "Config") .. ".rfld"
        if isfolder and makefolder and not isfolder(folder) then
            makefolder(folder)
        end
        local data = {}
        for flagName, flagObj in pairs(self.Flags) do
            if flagObj.Type == "ColorPicker" and typeof(flagObj.CurrentValue) == "Color3" then
                data[flagName] = {
                    R = math.floor(flagObj.CurrentValue.R * 255),
                    G = math.floor(flagObj.CurrentValue.G * 255),
                    B = math.floor(flagObj.CurrentValue.B * 255),
                    __type = "Color3"
                }
            else
                data[flagName] = flagObj.CurrentValue
            end
        end
        writefile(folder .. "/" .. file, HttpService:JSONEncode(data))
    end)
end

function Rayfield:LoadConfiguration()
    if not self.ConfigurationSaving.Enabled then
        return
    end
    pcall(function()
        if not readfile or not isfile then return end
        local folder = self.ConfigurationSaving.FolderName or self.Folder
        local path = folder .. "/" .. (self.ConfigurationSaving.FileName or "Config") .. ".rfld"
        if not isfile(path) then return end

        local decoded = HttpService:JSONDecode(readfile(path))
        if type(decoded) ~= "table" then return end

        for flagName, savedVal in pairs(decoded) do
            local flagObj = self.Flags[flagName]
            if flagObj and flagObj.Set then
                if type(savedVal) == "table" and savedVal.__type == "Color3" then
                    flagObj:Set(Color3.fromRGB(savedVal.R or 255, savedVal.G or 255, savedVal.B or 255))
                else
                    flagObj:Set(savedVal)
                end
            end
        end
    end)
end

