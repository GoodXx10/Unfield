                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 4),
                Parent = ListHolder
            })

            local DropdownObj = {
                Type = "Dropdown",
                CurrentOption = selected,
                CurrentValue = selected
            }

            local optionButtons = {}

            local function IsSelected(opt)
                for _, s in ipairs(selected) do
                    if s == opt then return true end
                end
                return false
            end

            local function UpdateOptionVisuals()
                SelectedLabel.Text = (#selected > 0) and table.concat(selected, ", ") or "None"
                DropdownObj.CurrentOption = selected
                DropdownObj.CurrentValue = selected
                for optName, btn in pairs(optionButtons) do
                    local active = IsSelected(optName)
                    Tween(btn, 0.2, {
                        BackgroundColor3 = active and theme.DropdownSelected or theme.DropdownUnselected
                    })
                end
            end

            local function RebuildOptions(newOptions)
                options = newOptions or options
                for _, child in ipairs(ListHolder:GetChildren()) do
                    if child:IsA("TextButton") then
                        child:Destroy()
                    end
                end
                optionButtons = {}

                for _, opt in ipairs(options) do
                    local optBtn = Create("TextButton", {
                        Size = UDim2.new(1, 0, 0, 28),
                        BackgroundColor3 = IsSelected(opt) and theme.DropdownSelected or theme.DropdownUnselected,
                        AutoButtonColor = false,
                        Font = Enum.Font.Gotham,
                        Text = "   " .. tostring(opt),
                        TextColor3 = theme.TextColor,
                        TextSize = 12,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        Parent = ListHolder
                    })
                    AddCorner(optBtn, 6)
                    optionButtons[opt] = optBtn

                    optBtn.MouseButton1Click:Connect(function()
                        if multi then
                            local idx = table.find(selected, opt)
                            if idx then
                                table.remove(selected, idx)
                            else
                                table.insert(selected, opt)
                            end
                        else
                            selected = { opt }
                        end
                        UpdateOptionVisuals()
                        task.spawn(callback, selected)
                        Rayfield:SaveConfiguration()
                    end)
                end
            end

            RebuildOptions(options)

            HeaderBtn.MouseButton1Click:Connect(function()
                expanded = not expanded
                local targetHeight = expanded and (48 + (#options * 32)) or 42
                Tween(DropCard, 0.3, { Size = UDim2.new(1, 0, 0, targetHeight) }, Enum.EasingStyle.Quint)
                Tween(ArrowLabel, 0.25, { Rotation = expanded and 180 or 0 })
            end)

            function DropdownObj:Set(newOpt)
                if type(newOpt) == "table" then
                    selected = newOpt
                else
                    selected = { newOpt }
                end
                UpdateOptionVisuals()
                task.spawn(callback, selected)
                Rayfield:SaveConfiguration()
            end

            function DropdownObj:Refresh(newOptions)
                RebuildOptions(newOptions)
                if expanded then
                    local targetHeight = 48 + (#options * 32)
                    Tween(DropCard, 0.3, { Size = UDim2.new(1, 0, 0, targetHeight) }, Enum.EasingStyle.Quint)
                end
            end

            if flag then
                Rayfield.Flags[flag] = DropdownObj
            end

            return DropdownObj
        end

        -- ====================================================================
        -- ELEMENT 10: KEYBIND
        -- ====================================================================
        function TabObj:CreateKeybind(kConfig)
            kConfig = kConfig or {}
            local kName = kConfig.Name or "Keybind"
            local currentKey = kConfig.CurrentKeybind or "F"
            local holdMode = (kConfig.HoldToInteract == true)
            local flag = kConfig.Flag
            local callback = kConfig.Callback or function() end

            local binding = false

            local KeyCard = Create("Frame", {
                Name = "Keybind_" .. kName,
                Size = UDim2.new(1, 0, 0, 40),
                BackgroundColor3 = theme.ElementBackground,
                Parent = Page
            })
            KeyCard:SetAttribute("SearchTitle", kName)
            AddCorner(KeyCard, 8)
            local CardStroke = AddStroke(KeyCard, theme.ElementStroke, 1, 0)
            AttachHoverAnimation(KeyCard, CardStroke)

            Create("TextLabel", {
                Position = UDim2.new(0, 12, 0, 0),
                Size = UDim2.new(0.65, -12, 1, 0),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamMedium,
                Text = kName,
                TextColor3 = theme.TextColor,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = KeyCard
            })

            local BindBtn = Create("TextButton", {
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -12, 0.5, 0),
                Size = UDim2.new(0, 74, 0, 26),
                BackgroundColor3 = theme.InputBackground,
                Font = Enum.Font.GothamBold,
                Text = tostring(currentKey),
                TextColor3 = theme.TextColor,
                TextSize = 12,
                Parent = KeyCard
            })
            AddCorner(BindBtn, 6)
            AddStroke(BindBtn, theme.InputStroke, 1, 0)

            local KeybindObj = {
                Type = "Keybind",
                CurrentKeybind = tostring(currentKey),
                CurrentValue = tostring(currentKey)
            }

            BindBtn.MouseButton1Click:Connect(function()
                binding = true
                BindBtn.Text = "..."
            end)

            UserInputService.InputBegan:Connect(function(input, gameProcessed)
                if binding then
                    if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
                        currentKey = input.KeyCode.Name
                        KeybindObj.CurrentKeybind = currentKey
                        KeybindObj.CurrentValue = currentKey
                        BindBtn.Text = currentKey
                        binding = false
                        Rayfield:SaveConfiguration()
                    end
                    return
                end

                if not gameProcessed and input.UserInputType == Enum.UserInputType.Keyboard then
                    if input.KeyCode.Name == tostring(currentKey) then
                        if holdMode then
                            task.spawn(callback, true)
                        else
                            task.spawn(callback, currentKey)
                        end
                    end
                end
            end)

            UserInputService.InputEnded:Connect(function(input, gameProcessed)
                if not binding and not gameProcessed and holdMode and input.UserInputType == Enum.UserInputType.Keyboard then
                    if input.KeyCode.Name == tostring(currentKey) then
                        task.spawn(callback, false)
                    end
                end
            end)

            function KeybindObj:Set(newKey)
                currentKey = tostring(newKey)
                KeybindObj.CurrentKeybind = currentKey
                KeybindObj.CurrentValue = currentKey
                BindBtn.Text = currentKey
                Rayfield:SaveConfiguration()
            end

            if flag then
                Rayfield.Flags[flag] = KeybindObj
            end

            return KeybindObj
        end

        -- ====================================================================
        -- ELEMENT 11: COLOR PICKER
        -- ====================================================================
        function TabObj:CreateColorPicker(cConfig)
            cConfig = cConfig or {}
            local cName = cConfig.Name or "Color Picker"
            local currentColor = cConfig.Color or Color3.fromRGB(88, 130, 255)
            local flag = cConfig.Flag
            local callback = cConfig.Callback or function() end

            local h, s, v = currentColor:ToHSV()
            local pickerOpen = false

            local ColorCard = Create("Frame", {
                Name = "ColorPicker_" .. cName,
                Size = UDim2.new(1, 0, 0, 42),
                BackgroundColor3 = theme.ElementBackground,
                ClipsDescendants = true,
                Parent = Page
            })
            ColorCard:SetAttribute("SearchTitle", cName)
            AddCorner(ColorCard, 8)
            local CardStroke = AddStroke(ColorCard, theme.ElementStroke, 1, 0)
            AttachHoverAnimation(ColorCard, CardStroke)

            local TopBtn = Create("TextButton", {
                Size = UDim2.new(1, 0, 0, 42),
                BackgroundTransparency = 1,
                Text = "",
                Parent = ColorCard
            })

            Create("TextLabel", {
                Position = UDim2.new(0, 12, 0, 0),
                Size = UDim2.new(0.65, -12, 1, 0),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamMedium,
                Text = cName,
                TextColor3 = theme.TextColor,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = TopBtn
            })

            local PreviewSwatch = Create("Frame", {
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -12, 0.5, 0),
                Size = UDim2.new(0, 38, 0, 22),
                BackgroundColor3 = currentColor,
                Parent = TopBtn
            })
            AddCorner(PreviewSwatch, 6)
            AddStroke(PreviewSwatch, theme.ElementStroke, 1, 0)

            local SlidersArea = Create("Frame", {
                Position = UDim2.new(0, 12, 0, 46),
                Size = UDim2.new(1, -24, 0, 90),
                BackgroundTransparency = 1,
                Parent = ColorCard
            })

            local RGBLabel = Create("TextLabel", {
                Position = UDim2.new(0, 0, 0, 68),
                Size = UDim2.new(1, 0, 0, 18),
                BackgroundTransparency = 1,
                Font = Enum.Font.Gotham,
                Text = string.format("RGB: %d, %d, %d", math.floor(currentColor.R * 255), math.floor(currentColor.G * 255), math.floor(currentColor.B * 255)),
                TextColor3 = theme.SubTextColor,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = SlidersArea
            })

            local ColorObj = {
                Type = "ColorPicker",
                Color = currentColor,
                CurrentValue = currentColor
            }

            local channelBars = {}
            local channels = {
                { Name = "H", Y = 0, Color = Color3.fromRGB(235, 95, 95) },
                { Name = "S", Y = 22, Color = Color3.fromRGB(95, 210, 140) },
                { Name = "V", Y = 44, Color = Color3.fromRGB(95, 155, 250) }
            }

            local function RefreshColor(fireCallback)
                currentColor = Color3.fromHSV(h, s, v)
                ColorObj.Color = currentColor
                ColorObj.CurrentValue = currentColor
                PreviewSwatch.BackgroundColor3 = currentColor
                RGBLabel.Text = string.format(
                    "RGB: %d, %d, %d",
                    math.floor(currentColor.R * 255),
                    math.floor(currentColor.G * 255),
                    math.floor(currentColor.B * 255)
                )
                if channelBars.H then channelBars.H.Size = UDim2.new(h, 0, 1, 0) end
                if channelBars.S then channelBars.S.Size = UDim2.new(s, 0, 1, 0) end
                if channelBars.V then channelBars.V.Size = UDim2.new(v, 0, 1, 0) end
                if fireCallback then
                    task.spawn(callback, currentColor)
                end
                Rayfield:SaveConfiguration()
            end

            for _, ch in ipairs(channels) do
                Create("TextLabel", {
                    Position = UDim2.new(0, 0, 0, ch.Y),
                    Size = UDim2.new(0, 18, 0, 16),
                    BackgroundTransparency = 1,
                    Font = Enum.Font.GothamBold,
                    Text = ch.Name,
                    TextColor3 = theme.SubTextColor,
                    TextSize = 11,
                    Parent = SlidersArea
                })

                local track = Create("Frame", {
                    Position = UDim2.new(0, 22, 0, ch.Y + 4),
                    Size = UDim2.new(1, -22, 0, 8),
                    BackgroundColor3 = theme.SliderBackground,
                    Parent = SlidersArea
                })
                AddCorner(track, 4)

                local initRatio = (ch.Name == "H" and h) or (ch.Name == "S" and s) or v
                local fill = Create("Frame", {
                    Size = UDim2.new(initRatio, 0, 1, 0),
                    BackgroundColor3 = ch.Color,
                    Parent = track
                })
                AddCorner(fill, 4)
                channelBars[ch.Name] = fill

                local draggingChannel = false
                local function UpdateChannel(input)
                    local ratio = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                    if ch.Name == "H" then h = ratio
                    elseif ch.Name == "S" then s = ratio
                    else v = ratio end
                    RefreshColor(true)
                end

                track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        draggingChannel = true
                        UpdateChannel(input)
                    end
                end)

                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        draggingChannel = false
                    end
                end)

                UserInputService.InputChanged:Connect(function(input)
                    if draggingChannel and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        UpdateChannel(input)
                    end
                end)
            end

            TopBtn.MouseButton1Click:Connect(function()
                pickerOpen = not pickerOpen
                Tween(ColorCard, 0.3, { Size = UDim2.new(1, 0, 0, pickerOpen and 142 or 42) }, Enum.EasingStyle.Quint)
            end)

            function ColorObj:Set(newColor3)
                if typeof(newColor3) == "Color3" then
                    h, s, v = newColor3:ToHSV()
                    RefreshColor(true)
                end
            end

            if flag then
                Rayfield.Flags[flag] = ColorObj
            end

            return ColorObj
        end

        return TabObj
    end

    table.insert(self.Windows, WindowObj)
    return WindowObj
end
