                TextSize = 16,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = KeyFrame
            })

            Create("TextLabel", {
                Position = UDim2.new(0, 20, 0, 44),
                Size = UDim2.new(1, -40, 0, 18),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamMedium,
                Text = ks.Subtitle or "Key Verification",
                TextColor3 = theme.Accent,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = KeyFrame
            })

            Create("TextLabel", {
                Position = UDim2.new(0, 20, 0, 68),
                Size = UDim2.new(1, -40, 0, 32),
                BackgroundTransparency = 1,
                Font = Enum.Font.Gotham,
                Text = ks.Note or "Enter your access key below to unlock.",
                TextColor3 = theme.SubTextColor,
                TextSize = 12,
                TextWrapped = true,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = KeyFrame
            })

            local KeyBox = Create("TextBox", {
                Position = UDim2.new(0, 20, 0, 110),
                Size = UDim2.new(1, -40, 0, 36),
                BackgroundColor3 = theme.InputBackground,
                Font = Enum.Font.Gotham,
                PlaceholderText = "Enter Key...",
                PlaceholderColor3 = theme.PlaceholderColor,
                Text = "",
                TextColor3 = theme.TextColor,
                TextSize = 13,
                ClearTextOnFocus = false,
                Parent = KeyFrame
            })
            AddCorner(KeyBox, 8)
            AddStroke(KeyBox, theme.InputStroke, 1, 0)

            local SubmitBtn = Create("TextButton", {
                Position = UDim2.new(0, 20, 0, 158),
                Size = UDim2.new(1, -40, 0, 36),
                BackgroundColor3 = theme.Accent,
                Font = Enum.Font.GothamBold,
                Text = "Verify Key",
                TextColor3 = Color3.fromRGB(255, 255, 255),
                TextSize = 13,
                Parent = KeyFrame
            })
            AddCorner(SubmitBtn, 8)

            SubmitBtn.MouseButton1Click:Connect(function()
                local entered = KeyBox.Text
                local matched = false
                for _, k in ipairs(validKeys) do
                    if entered == k then
                        matched = true
                        break
                    end
                end
                if matched then
                    pcall(function()
                        if ks.SaveKey and writefile then
                            writefile((ks.FileName or "Key") .. ".rfldkey", entered)
                        end
                    end)
                    KeyFrame:Destroy()
                    PlaySignatureMorphIntro()
                else
                    -- Signature Shake Animation on Wrong Key
                    local basePos = KeyFrame.Position
                    Tween(KeyStroke, 0.15, { Color = Color3.fromRGB(240, 75, 75) })
                    task.spawn(function()
                        for _, offset in ipairs({ -10, 10, -7, 7, -3, 0 }) do
